  object qryNFe: TFDQuery
    Active = True
    Connection = Conexao.FDConnection1
    SQL.Strings = (
      'SELECT '
      '  NUMERO_NFE, '
      '  SERIE, '
      '  EMITENTE, '
      '  CHAVE_NFE, '
      '  CAST(PESO AS DECIMAL(15,3))             AS PESO, '
      '  QUANTIDADE, '
      '  CAST(VALOR_MERCADORIA AS DECIMAL(15,2)) AS VALOR_MERCADORIA '
      'FROM OS_NFE '
      'WHERE ID_OS = :pOS '
      'ORDER BY ID')
    Left = 784
    Top = 88
    ParamData = <
      item
        Name = 'POS'
        DataType = ftInteger
        ParamType = ptInput
        Value = Null
      end>
